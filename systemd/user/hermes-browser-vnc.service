[Unit]
Description=Hermes Shared Browser - x11vnc bridge
Documentation=file:README.md
After=hermes-browser-xvfb.service
Requires=hermes-browser-xvfb.service

[Service]
Type=simple
EnvironmentFile=%E/hermes-shared-browser/env
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp
ReadWritePaths=%E/hermes-shared-browser
ReadWritePaths=%t/hermes-shared-browser
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
TasksMax=64
# PrivateTmp omitted so the VNC bridge can use /tmp/.X11-unix created by Xvfb.
ExecStartPre=%E/hermes-shared-browser/bin/assert-loopback.sh VNC_HOST ${VNC_HOST}
ExecStart=%E/hermes-shared-browser/bin/start-x11vnc.sh
ExecStartPost=%E/hermes-shared-browser/bin/wait-for-port.sh ${VNC_HOST} ${VNC_PORT}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
